# Koneksi PostgreSQL (ganti YOUR_POSTGRES_PASSWORD dengan password Anda)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/apps

# Port server API Express
PORT=3001

# Akun admin awal, dipakai oleh "npm run db:admin" (server/create-admin.js)
ADMIN_EMAIL=admin@lumina.test
ADMIN_PASSWORD=lumina123
ADMIN_NAME=Administrator

# Secret unik untuk menandatangani token login (HMAC-SHA256).
# Boleh kosong hanya di development; production akan gagal start jika secret kurang dari 32 karakter.
AUTH_TOKEN_SECRET=

# Upstash Redis REST untuk pembatasan percobaan login/OTP lintas instance.
# Opsional di development; wajib di production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Konfigurasi SMTP untuk mengirim kode OTP ke email asli.
# Isi untuk mengirim OTP ke email asli; jika dikosongkan, OTP dicetak ke console server (mode development).
# Untuk Gmail, gunakan App Password (bukan password akun biasa).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Lumina

# Backup harian ke Cloudflare R2 (S3-compatible).
# Buat API token dengan akses Object Read & Write hanya ke bucket backup.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
CRON_SECRET=
# Isi nilai R2_* dan CRON_SECRET di environment proyek API, bukan di frontend.

# Biteship. Kode pos asal mengikuti alamat toko yang diberikan.
# Couriers adalah daftar kode kurir Biteship dipisahkan koma (mis. jne,sicepat).
BITESHIP_API_KEY=
BITESHIP_ORIGIN_POSTAL_CODE=17610
BITESHIP_COURIERS=
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_CONTACT_EMAIL=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORGANIZATION=
BITESHIP_ORIGIN_COLLECTION_METHOD=
# Berat produk dalam gram dipakai untuk menghitung ongkir dan membuat pengiriman.

# Midtrans Snap. Untuk callback, atur URL publik:
# https://<API_DOMAIN>/api/payment/midtrans/notification
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=
STOREFRONT_URL=
