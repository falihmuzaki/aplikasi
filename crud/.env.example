# Koneksi PostgreSQL (ganti YOUR_POSTGRES_PASSWORD dengan password Anda)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/apps

# Port server API Express
PORT=3001

# Akun admin awal, dipakai oleh "npm run db:admin" (server/create-admin.js)
ADMIN_EMAIL=admin@lumina.test
ADMIN_PASSWORD=lumina123
ADMIN_NAME=Administrator

# Secret untuk menandatangani token login (HMAC-SHA256).
# Kosongkan untuk development (ada fallback di kode); WAJIB diisi nilai acak panjang di production.
AUTH_TOKEN_SECRET=

# Konfigurasi SMTP untuk mengirim kode OTP ke email asli.
# Isi untuk mengirim OTP ke email asli; jika dikosongkan, OTP dicetak ke console server (mode development).
# Untuk Gmail, gunakan App Password (bukan password akun biasa).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Lumina
